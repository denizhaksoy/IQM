#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input{double value[];}src;
layout(set=0,binding=1,std430) buffer Output{double value[];}dst;
layout(set=0,binding=2,std430) readonly buffer Model{double value[];}model;
layout(push_constant) uniform Push{uint width;uint mode;uint unused0;uint unused1;}p;
double divideCorrected(double a,double d){if(a==0.0lf)return a;precise double q=a/d;if(isinf(q))return q;precise double r=fma(-q,d,a);precise double c=r/d;precise double result=q+c;return result;}
void main(){uint i=gl_GlobalInvocationID.x,n=p.width*p.width;if(p.mode==2u){if(i!=0u)return;precise double sum=0.0lf,correction=0.0lf;for(uint x=0u;x<p.width;++x)for(uint y=0u;y<p.width;++y){double value=dst.value[y*p.width+x];precise double next=sum+value;precise double delta;if(abs(sum)>=abs(value))delta=(sum-next)+value;else delta=(value-next)+sum;precise double updated=correction+delta;correction=updated;sum=next;}precise double total=sum+correction;dst.value[3u*n]=divideCorrected(total,double(n));return;}if(i>=n)return;if(p.mode==1u){dst.value[2u*n+i]=model.value[0];return;}
 double v=clamp(src.value[i],-5.0lf,5.0lf),query=clamp(v,model.value[0],model.value[255]);uint lo=0u,hi=256u;while(lo<hi){uint mid=(lo+hi)/2u;if(query<model.value[mid])hi=mid;else lo=mid+1u;}uint upper=min(lo,255u),lower=upper-1u;precise double delta=query-model.value[lower];precise double product=model.value[512u+lower]*delta;precise double sensitivity=product+model.value[256u+lower];dst.value[i]=v;dst.value[n+i]=sensitivity;dst.value[2u*n+i]=divideCorrected(1.0lf,sensitivity);
}
