#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input{double value[];}src;
layout(set=0,binding=1,std430) writeonly buffer Output{double value[];}dst;
layout(set=0,binding=2,std430) readonly buffer Coefficients{double value[];}coeff;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=9216u)return;
 precise double r=clamp(src.value[i],1e-5lf,1e10lf),g=clamp(src.value[9216u+i],1e-5lf,1e10lf),b=clamp(src.value[18432u+i],1e-5lf,1e10lf);
 double channels[4];for(uint c=0u;c<4u;++c){precise double first=r*coeff.value[c];precise double second=fma(g,coeff.value[4u+c],first);precise double result=fma(b,coeff.value[8u+c],second);dst.value[c*9216u+i]=result;channels[c]=clamp(result,1e-8lf,1e10lf);dst.value[(4u+c)*9216u+i]=channels[c];}
 precise double adaptation=channels[0]+channels[1];dst.value[73728u+i]=adaptation;
}
