#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input {float value[];} src;
layout(set=0,binding=1,std430) writeonly buffer Output {float value[];} dst;
layout(push_constant) uniform Push {uint count,a,b,c;} p;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=p.count)return;
    precise float product=src.value[i]*src.value[p.count+i];dst.value[i]=product;}
