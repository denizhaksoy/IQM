#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input{double value[];}src;
layout(set=0,binding=1,std430) buffer Output{double value[];}dst;
layout(set=0,binding=2,std430) readonly buffer Plan{double value[];}plan;
layout(push_constant) uniform Push{uint width;uint height;uint outputWidth;uint mode;}p;
void main(){uint i=gl_GlobalInvocationID.x;uint n=p.mode==0u?p.height*p.outputWidth:p.outputWidth*p.outputWidth;if(i>=n)return;
 if(p.mode==3u){dst.value[i]=0.0lf;return;}if(p.mode==2u){precise double next=dst.value[i]+max(src.value[i],0.0lf);dst.value[i]=next;return;}
 uint x=i%p.outputWidth,y=i/p.outputWidth,d=p.mode==0u?x:y,taps=uint(plan.value[0]);precise double sum=0.0lf;
 for(uint t=0u;t<taps;++t){uint k=1u+p.outputWidth+2u*(d*taps+t),source=uint(plan.value[k]);double value=p.mode==0u?src.value[y*p.width+source]:src.value[source*p.width+x];precise double product=value*plan.value[k+1u];precise double next=sum+product;sum=next;}
 precise double result=sum/plan.value[1u+d];dst.value[i]=result;
}
