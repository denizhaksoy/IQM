#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input{double value[];}src;
layout(set=0,binding=1,std430) writeonly buffer Output{double value[];}dst;
layout(set=0,binding=2,std430) readonly buffer Filter{double value[];}coeff;
layout(push_constant) uniform Push{uint width;uint kernel;uint step;uint mode;}p;
int reflect1(int x,int n){if(x<0)return -x;if(x>=n)return 2*n-2-x;return x;}
double divideCorrected(double a,double d){if(a==0.0lf)return a;precise double q=a/d;precise double r=fma(-q,d,a);precise double c=r/d;precise double result=q+c;return result;}
void main(){uint i=gl_GlobalInvocationID.x;if(p.mode==16u){if(i!=0u)return;precise double sum=0.0lf;precise double correction=0.0lf;for(uint x=0u;x<12u;++x)for(uint y=0u;y<12u;++y){double value=src.value[y*12u+x];precise double next=sum+value;precise double delta;if(abs(sum)>=abs(value))delta=(sum-next)+value;else delta=(value-next)+sum;precise double updated=correction+delta;correction=updated;sum=next;}precise double total=sum+correction;double mean=divideCorrected(total,144.0lf);dst.value[144]=mean;for(uint j=0u;j<144u;++j){precise double centered=src.value[j]-mean;dst.value[j]=centered;}return;}
 uint w=(p.width+p.step-1u)/p.step;if(i>=w*w)return;uint x=i%w,y=i/w;precise double sum=0.0lf;
 for(uint ix=0u;ix<p.kernel;++ix)for(uint iy=0u;iy<p.kernel;++iy){int fx=int(p.kernel-1u-ix),fy=int(p.kernel-1u-iy),sx=reflect1(int(x*p.step)+fx-int(p.kernel/2u),int(p.width)),sy=reflect1(int(y*p.step)+fy-int(p.kernel/2u),int(p.width));double value=src.value[uint(sy)*p.width+uint(sx)],c=coeff.value[uint(fy)*p.kernel+uint(fx)];if(y*p.step<(p.width/16u)*16u)sum=fma(value,c,sum);else{precise double product=value*c;precise double next=sum+product;sum=next;}}
 precise double normalized=sum/double(1u<<p.mode);dst.value[i]=normalized;
}
