void main(){uint i=gl_GlobalInvocationID.x;if(p.mode==0u){if(i>=36864u)return;precise double value=src.value[i]*model.value[0];dst.value[i]=value;return;}if(i>=9216u)return;double channels[3];for(uint c=0u;c<3u;++c){double query=src.value[c*9216u+i];uint lo=0u,hi=2048u;while(lo<hi){uint mid=(lo+hi)/2u;if(query<model.value[mid])hi=mid;else lo=mid+1u;}uint k=clamp(lo,1u,2047u)-1u,table=c==2u?4096u:2048u,slope=c==2u?8192u:6144u;precise double delta=query-model.value[k];precise double product=model.value[slope+k]*delta;precise double value=product+model.value[table+k];channels[c]=value;dst.value[c*9216u+i]=value;}dst.value[27648u+i]=0.0lf;precise double first=channels[0]+channels[1];precise double response=first+channels[2];dst.value[36864u+i]=response;}
