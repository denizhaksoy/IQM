#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input {double v[];} src;
layout(set=0,binding=1,std430) writeonly buffer Output {double v[];} dst;
layout(push_constant) uniform Push {uint count;uint unused1;uint unused2;uint unused3;} p;
double divideCorrected(double a,double b){precise double q=a/b;precise double r=fma(-q,b,a);precise double c=r/b;precise double result=q+c;return result;}
// Diagnostic only: positive normal finite arguments. No production fallback.
// frexp reduces to [sqrt(.5),sqrt(2)); atanh series through z^41.
double candidateLog(double x){
 int e;double m=frexp(x,e);if(m<0.70710678118654752440lf){m=m*2.0lf;e-=1;}
 precise double numerator=m-1.0lf,denominator=m+1.0lf;
 double z=divideCorrected(numerator,denominator);precise double z2=z*z;
 precise double poly=1.0lf/41.0lf;
 for(int k=39;k>=3;k-=2)poly=fma(poly,z2,1.0lf/double(k));
 precise double tail=z*z2;precise double small=2.0lf*fma(tail,poly,z);
 precise double low=double(e)*1.90821492927058770002e-10lf;
 precise double high=double(e)*6.93147180369123816490e-1lf;
 precise double result=high+(small+low);return result;
}
void main(){uint i=gl_GlobalInvocationID.x;if(i>=p.count)return;double value=candidateLog(src.v[i]);dst.v[2u*i]=value;precise double base10=value*0.43429448190325182765lf;dst.v[2u*i+1u]=base10;}
