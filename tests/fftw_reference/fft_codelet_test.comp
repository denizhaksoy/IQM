            for(uint j=0;j<8;++j) {
                uint index=p.graph==3?(batch/128)*16384+(k+16*j)*128+batch%128:batch*128+k+16*j;
                dst.value[index]=vec2(ii[j],ri[j]);
            }
        }
    }
