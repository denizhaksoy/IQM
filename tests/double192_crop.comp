#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input{dvec2 value[];}src;
layout(set=0,binding=1,std430) writeonly buffer Output{dvec2 value[];}dst;
layout(push_constant) uniform Push{uint n;uint batches;uint graph;uint fused;}p;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=p.batches*9216u)return;uint matrix=i/9216u,j=i%9216u;dst.value[i]=src.value[matrix*36864u+(j/96u)*192u+j%96u];}
