#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Reference{double value[];}reference;
layout(set=0,binding=1,std430) writeonly buffer Output{double value[];}dst;
layout(set=0,binding=2,std430) readonly buffer Test{double value[];}testImage;
double divideCorrected(double a,double d){if(a==0.0lf)return a;precise double q=a/d;if(isinf(q))return q;precise double r=fma(-q,d,a);precise double c=r/d;precise double result=q+c;return result;}
void main(){uint i=gl_GlobalInvocationID.x;if(i>=9216u)return;bool different=false;for(uint c=0u;c<3u;++c){uint k=c*9216u+i;double r=reference.value[k];precise double delta=testImage.value[k]-r;double a=abs(delta);if(r==0.0lf){if(a>0.0lf&&(unpackDouble2x32(r).y&0x80000000u)==0u)different=true;}else if(divideCorrected(a,r)>0.001lf)different=true;}dst.value[i]=different?1.0lf:0.0lf;}
