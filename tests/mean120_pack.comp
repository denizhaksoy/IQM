#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input {uint words[];} src;
layout(set=0,binding=1,std430) writeonly buffer Output {uint words[];} dst;
layout(push_constant) uniform Push {uint groups,h,w,reserved;} p;
void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=p.groups*120u)return;
    uint group=i/120u,row=i%120u,y=row/p.w,x=row%p.w;
    uint column=group*120u+x*p.h+y;
    dst.words[2u*column]=src.words[group*121u+1u+row];dst.words[2u*column+1u]=0u;
}
