#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input{double value[];}src;
layout(set=0,binding=1,std430) writeonly buffer Output{double value[];}dst;
layout(set=0,binding=2,std430) readonly buffer Model{double value[];}model;
layout(push_constant) uniform Push{uint width;uint height;uint mode;uint unused;}p;
double divideCorrected(double a,double d){precise double q=a/d;if(a==0.0lf||isinf(d)||isinf(q))return q;precise double r=fma(-q,d,a);precise double c=r/d;precise double result=q+c;return result;}
void main(){uint i=gl_GlobalInvocationID.x,n=p.width*p.height;if(p.mode==1u){if(i!=0u)return;precise double sum=0.0lf;for(uint x=0u;x<p.width;++x)for(uint y=0u;y<p.height;++y){precise double term=divideCorrected(src.value[y*p.width+x],double(n));precise double next=sum+term;sum=next;}dst.value[0]=sum;return;}if(i>=n)return;
 precise double own=model.value[0]*src.value[i],adjacent=model.value[2]*src.value[n+i];precise double first=own+model.value[1];precise double mask=first+adjacent;double delta=src.value[3u*n+i],signValue=delta>0.0lf?1.0lf:delta<0.0lf?-1.0lf:0.0lf;precise double excitation=signValue*src.value[2u*n+i];precise double square=mask*mask;precise double variance=src.value[4u*n+i]+square;precise double root=sqrt(variance);double difference=divideCorrected(excitation,root);precise double masked=difference*src.value[5u*n+i];dst.value[i]=mask;dst.value[n+i]=excitation;dst.value[2u*n+i]=difference;dst.value[3u*n+i]=masked;dst.value[4u*n+i]=root;
}
