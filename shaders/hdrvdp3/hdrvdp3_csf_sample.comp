#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer LogInput {
    float logInput[];
};

layout(std430, binding = 1) readonly buffer Grid {
    float grid[];
};

layout(std430, binding = 2) readonly buffer Sensitivity {
    float sensitivity[];
};

layout(std430, binding = 3) readonly buffer Slopes {
    float slopes[];
};

layout(std430, binding = 4) writeonly buffer Output {
    float outputValues[];
};

layout(push_constant) uniform Params {
    uint count;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x +
             gl_GlobalInvocationID.y *
             gl_NumWorkGroups.x *
             gl_WorkGroupSize.x;

    if (i >= pc.count)
        return;

    precise float q = clamp(
        logInput[i], grid[0], grid[255]
    );

    uint lo = 0u;
    uint hi = 256u;

    while (lo < hi) {
        uint mid = lo + (hi - lo) / 2u;

        if (q < grid[mid])
            hi = mid;
        else
            lo = mid + 1u;
    }

    uint upper = clamp(lo, 1u, 255u);
    uint lower = upper - 1u;

    precise float offset = q - grid[lower];
    precise float product = slopes[lower] * offset;
    precise float value = product + sensitivity[lower];

    outputValues[i] = value;
}
