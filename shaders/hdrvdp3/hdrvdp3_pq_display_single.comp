#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer Input {float v[];} inputBuf;
layout(set=0,binding=1,std430) writeonly buffer Output {float v[];} outputBuf;
layout(push_constant) uniform P {uint count; float ambient; float limit; uint pad;} p;
void main(){
 uint i=gl_GlobalInvocationID.x;
 if(i>=p.count) return;
  precise float unit=inputBuf.v[i];
 if(p.pad==1u)
     unit=unit/65535.0;
 float t=pow(unit,1.0/78.84375);
 float numerator=max(t-0.8359375,0.0);
 float denominator=18.8515625-18.6875*t;
 float ratio=numerator/denominator;
 float linear=10000.0*pow(ratio,1.0/0.1593017578125);
 outputBuf.v[i]=min(linear+p.ambient,p.limit);
}
