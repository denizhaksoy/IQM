#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 64, local_size_y = 1) in;

layout(std430, binding = 0) readonly buffer RefAdapt {
    float refAdapt[];
};

layout(std430, binding = 1) readonly buffer TestAdapt {
    float testAdapt[];
};

layout(std430, binding = 2) writeonly buffer LogAdapt {
    float logAdapt[];
};

layout(push_constant) uniform Params {
    uint count;
} pc;

double log64(double x) {
    int exponent;

    precise double m = frexp(x, exponent);

    m = m * 2.0LF;
    exponent -= 1;

    precise double z = (m - 1.0LF) / (m + 1.0LF);
    precise double z2 = z * z;

    precise double term = z;
    precise double sumValue = z;

    for (int k = 3; k <= 61; k += 2) {
        term = term * z2;
        sumValue = sumValue + term / double(k);
    }

    precise double result =
        2.0LF * sumValue +
        double(exponent) * 0.693147180559945309417232121458LF;

    return result;
}

void main() {
    uint i = gl_GlobalInvocationID.x +
             gl_GlobalInvocationID.y *
             gl_NumWorkGroups.x *
             gl_WorkGroupSize.x;

    if (i >= pc.count)
        return;

    precise float sumValue = testAdapt[i] + refAdapt[i];
    precise float meanValue = sumValue / 2.0;
    precise float lum = clamp(meanValue, 1e-5, 1e5);

    precise double result =
        log64(double(lum)) /
        2.302585092994045684017991454684LF;

    logAdapt[i] = float(result);
}