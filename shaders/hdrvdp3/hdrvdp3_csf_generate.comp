#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer LogInput {
    float logInput[];
};

layout(std430, binding = 1) readonly buffer Frequency {
    double residualFrequency[];
};

layout(std430, binding = 2) writeonly buffer Grid {
    float grid[];
};

layout(std430, binding = 3) writeonly buffer Sensitivity {
    float sensitivity[];
};

layout(std430, binding = 4) writeonly buffer Slopes {
    float slopes[];
};

layout(std430, binding = 5) writeonly buffer Noise {
    double baseNoise[];
};

layout(push_constant) uniform Params {
    double bandFrequency;
    uint width;
    uint height;
    uint mode;
} pc;

const double LN2 =
    0.693147180559945309417232121458176568LF;

const double LN10 =
    2.302585092994045684017991454684364208LF;

const double LUMS[7] = double[7](
    0.0002LF, 0.002LF, 0.02LF,
    0.2LF, 2.0LF, 20.0LF, 150.0LF
);

const dvec4 PARAMETERS[7] = dvec4[7](
    dvec4(1.26181LF,4.27832LF,0.361902LF,3.11914LF),
    dvec4(0.893585LF,4.27832LF,0.361902LF,2.18938LF),
    dvec4(0.84864LF,3.57253LF,0.530355LF,3.12486LF),
    dvec4(0.699243LF,3.94545LF,0.68608LF,4.41846LF),
    dvec4(0.530826LF,4.25337LF,0.866916LF,4.65117LF),
    dvec4(0.459297LF,3.78765LF,0.981028LF,4.33546LF),
    dvec4(0.312626LF,4.15264LF,0.952367LF,3.22389LF)
);

double log64(double x) {
    int exponent;

    precise double m = frexp(x, exponent);

    m = m * 2.0LF;
    exponent -= 1;

    precise double z =
        (m - 1.0LF) / (m + 1.0LF);

    precise double z2 = z * z;
    precise double term = z;
    precise double sumValue = z;

    for (int k = 3; k <= 61; k += 2) {
        term = term * z2;
        sumValue = sumValue + term / double(k);
    }

    precise double result =
        2.0LF * sumValue + double(exponent) * LN2;

    return result;
}

double exp64(double x) {
    if (x < -745.0LF)
        return 0.0LF;

    int exponent = int(floor(x / LN2 + 0.5LF));

    precise double r =
        x - double(exponent) * LN2;

    precise double term = 1.0LF;
    precise double sumValue = 1.0LF;

    for (int k = 1; k <= 24; ++k) {
        term = term * r / double(k);
        sumValue = sumValue + term;
    }

    return ldexp(sumValue, exponent);
}

double pow64(double x, double y) {
    if (x == 0.0LF)
        return y == 0.0LF ? 1.0LF : 0.0LF;

    return exp64(y * log64(x));
}

double log10_64(double x) {
    return log64(x) / LN10;
}

double mtf64(double rho) {
    const double p1 = 0.061466549455263LF;
    const double p2 = 0.99727370023777070LF;

    const double a[4] = double[4](
        p2 * 0.426LF,
        p2 * 0.574LF,
        (1.0LF-p2) * p1,
        (1.0LF-p2) * (1.0LF-p1)
    );

    const double b[4] = double[4](
        0.028LF, 0.37LF, 37.0LF, 360.0LF
    );

    precise double value = 0.0LF;

    for (int i = 0; i < 4; ++i)
        value = value + a[i] * exp64(-b[i] * rho);

    return value;
}

dvec4 interpolate64(double lum) {
    precise double q =
        log10_64(clamp(lum,LUMS[0],LUMS[6]));

    for (int i = 0; i < 6; ++i) {
        double x0 = log10_64(LUMS[i]);
        double x1 = log10_64(LUMS[i+1]);

        if (q <= x1) {
            precise dvec4 slope =
                (PARAMETERS[i+1]-PARAMETERS[i]) /
                (x1-x0);

            precise dvec4 value =
                slope * (q-x0) + PARAMETERS[i];

            return value;
        }
    }

    return PARAMETERS[6];
}

dvec4 interpolateSingle(float lum) {
    float nodes[7];

    for (int i = 0; i < 7; ++i)
        nodes[i] = float(log10_64(LUMS[i]));

    precise float q = clamp(
        float(log10_64(double(lum))),
        nodes[0],nodes[6]
    );

    int upper = 1;

    while (upper < 6 && q >= nodes[upper])
        ++upper;

    int lower = upper-1;

    double x0 = log10_64(LUMS[lower]);
    double x1 = log10_64(LUMS[upper]);

    precise vec4 slope = vec4(
        (PARAMETERS[upper]-PARAMETERS[lower]) /
        (x1-x0)
    );

    precise float offset = q-nodes[lower];
    precise vec4 product = slope*offset;

    precise vec4 result =
        product + vec4(PARAMETERS[lower]);

    return dvec4(result);
}

double ncsf64(double rho,dvec4 p) {
    if (rho <= 1e-4LF)
        return 0.0LF;

    precise double term1 =
        1.0LF + pow64(p.x*rho,p.y);

    precise double term2 =
        1.0LF - exp64(-pow64(rho/7.0LF,2.0LF));

    precise double denominator =
        pow64(term1/pow64(term2,p.z),0.5LF);

    precise double value = p.w/denominator;

    value = value/mtf64(rho);

    // Current IQM Single profile uses age 24.
    // AESL multiplier is exactly one at age 24.

    return value;
}

double nodeExponent(uint i) {
    uint distance = min(i,255u-i);

    precise double magnitude =
        5.0LF-double(distance)*(10.0LF/255.0LF);

    return i < 128u ? -magnitude : magnitude;
}

double nodeLuminance(uint i) {
    return pow64(10.0LF,nodeExponent(i));
}

void main() {
    uint i = gl_GlobalInvocationID.x;

    // Mode 0: generate the 256-node CSF table.
    if (pc.mode == 0u) {
        if (i >= 256u)
            return;

        double lum = nodeLuminance(i);
        double x0 = log10_64(lum);

        double s0 = ncsf64(
            pc.bandFrequency,
            interpolate64(lum)
        );

        grid[i] = float(x0);
        sensitivity[i] = float(s0);

        if (i < 255u) {
            double nextLum = nodeLuminance(i+1u);
            double x1 = log10_64(nextLum);

            double s1 = ncsf64(
                pc.bandFrequency,
                interpolate64(nextLum)
            );

            slopes[i] = float((s1-s0)/(x1-x0));
        }

        return;
    }

    // Mode 1: residual neural noise.
    if (pc.mode == 1u && i == 0u) {
        precise double sumValue = 0.0LF;

        // Preserve the CPU column-major accumulation order.
        for (uint x = 0u; x < pc.width; ++x) {
            for (uint y = 0u; y < pc.height; ++y) {
                float v = clamp(
                    logInput[y*pc.width+x],
                    -5.0,5.0
                );

                sumValue = sumValue + double(v);
            }
        }

        precise float meanLog = float(
            sumValue /
            double(pc.width*pc.height)
        );

        precise float lum =
            float(pow64(10.0LF,double(meanLog)));

        double csf = ncsf64(
            residualFrequency[0],
            interpolateSingle(lum)
        );

        baseNoise[0] = 1.0LF/csf;
    }
}
