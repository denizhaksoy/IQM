#version 450
#extension GL_ARB_gpu_shader_fp64 : require

const double LN2 =
    0.693147180559945309417232121458176568LF;

double log64(double x) {
    int exponent;

    precise double m = frexp(x, exponent);

    m = m * 2.0LF;
    exponent -= 1;

    precise double z =
        (m - 1.0LF) / (m + 1.0LF);

    precise double z2 = z * z;
    precise double term = z;
    precise double sumValue = z;

    for (int k = 3; k <= 61; k += 2) {
        term = term * z2;
        sumValue = sumValue + term / double(k);
    }

    precise double result =
        2.0LF * sumValue + double(exponent) * LN2;

    return result;
}

double exp64(double x) {
    if (x < -745.0LF)
        return 0.0LF;

    int exponent = int(floor(x / LN2 + 0.5LF));

    precise double r =
        x - double(exponent) * LN2;

    precise double term = 1.0LF;
    precise double sumValue = 1.0LF;

    for (int k = 1; k <= 24; ++k) {
        term = term * r / double(k);
        sumValue = sumValue + term;
    }

    return ldexp(sumValue, exponent);
}

double pow64(double x, double y) {
    if (x == 0.0LF)
        return y == 0.0LF ? 1.0LF : 0.0LF;

    return exp64(y * log64(x));
}



float poolingPower(float x,float y) {
    if(isnan(x)) return x;
    if(isinf(x)) return x;
    if(x==0.0) return 0.0;
    return float(pow64(double(x),double(y)));
}


layout(local_size_x=64) in;

layout(std430,set=0,binding=0)
readonly buffer RawDifference {
    float v[];
} rawDifference;

layout(std430,set=0,binding=1)
readonly buffer ComparisonMask {
    double v[];
} comparisonMask;

layout(std430,set=0,binding=2)
writeonly buffer PoolingTerms {
    float v[];
} poolingTerms;

layout(push_constant) uniform Push {
    uint count;
} pc;

void main() {
    uint i=gl_GlobalInvocationID.x+
        gl_GlobalInvocationID.y*
        gl_NumWorkGroups.x*
        gl_WorkGroupSize.x;

    if(i>=pc.count) return;

    precise float masked=
        rawDifference.v[i]*
        float(comparisonMask.v[i]);

    precise float powered=
        poolingPower(abs(masked),0.8);

    precise float term=
        powered/float(pc.count);

    poolingTerms.v[i]=term;
}