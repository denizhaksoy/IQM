#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x=256) in;

layout(set=0,binding=0,std430) readonly buffer Input {
    float v[];
} inputBuf;

layout(set=0,binding=1,std430) writeonly buffer Output {
    float v[];
} outputBuf;

layout(push_constant) uniform P {
    uint count;
    float ambient;
    float limit;
    uint pad;
} p;

const double LN2 = 0.693147180559945309417232121458176568LF;

// Positive Float32 input -> high precision logarithm
double log_high_precision(float x)
{
    int exponent;

    float mantissa = frexp(x, exponent);

    precise double m = double(mantissa);

    if (m < 0.70710678118654752440LF) {
        m *= 2.0LF;
        exponent -= 1;
    }

    precise double z = (m - 1.0LF) / (m + 1.0LF);
    precise double z2 = z * z;

    precise double term = z;
    precise double sum = z;

    for (int k = 3; k <= 31; k += 2) {
        term *= z2;
        sum += term / double(k);
    }

    return 2.0LF * sum + double(exponent) * LN2;
}

// High precision exponential with range reduction
double exp_high_precision(double x)
{
    int k = int(floor(x / LN2 + 0.5LF));

    precise double r = x - double(k) * LN2;

    precise double term = 1.0LF;
    precise double sum = 1.0LF;

    for (int n = 1; n <= 20; ++n) {
        term = term * r / double(n);
        sum += term;
    }

    return ldexp(sum, k);
}

// Positive-base power for the PQ domain
float pow_high_precision(float x, float y)
{
    if (x == 0.0)
        return 0.0;

    if (x == 1.0)
        return 1.0;

    precise double logarithm = log_high_precision(x);

    precise double exponent = double(y) * logarithm;

    precise double result = exp_high_precision(exponent);

    return float(result);
}

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= p.count)
        return;

    precise float unit = inputBuf.v[i];

    precise float t = pow_high_precision(
        unit, 1.0 / 78.84375);

    precise float numerator =
        max(t - 0.8359375, 0.0);

    precise float product =
        18.6875 * t;

    precise float denominator =
        18.8515625 - product;

    precise float ratio =
        float(double(numerator) / double(denominator));

    precise float power =
        pow_high_precision(
            ratio, 1.0 / 0.1593017578125);

    precise float linear =
        10000.0 * power;

    precise float reflected =
        linear + p.ambient;

    outputBuf.v[i] =
        min(reflected, p.limit);
}
