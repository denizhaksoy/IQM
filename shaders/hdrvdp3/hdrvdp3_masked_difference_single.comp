#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer ReferenceBand {
    float referenceBand[];
};

layout(std430, binding = 1) readonly buffer TestBand {
    float testBand[];
};

layout(std430, binding = 2) readonly buffer SelfActivity {
    float selfActivity[];
};

layout(std430, binding = 3) readonly buffer NeighborActivity {
    float neighborActivity[];
};

layout(std430, binding = 4) readonly buffer Sensitivity {
    float sensitivity[];
};

layout(std430, binding = 5) readonly buffer BaseNoise {
    double baseNoise[];
};

layout(std430, binding = 6) writeonly buffer RawDifference {
    float rawDifference[];
};

layout(push_constant) uniform Params {
    double p;
    uint count;
    uint residual;
    float q;
    float ks;
    float kn;
} pc;

const double LN2 =
    0.693147180559945309417232121458176568LF;

double log64(double x) {
    int exponent;

    precise double m = frexp(x, exponent);

    m = m * 2.0LF;
    exponent -= 1;

    precise double z =
        (m - 1.0LF) / (m + 1.0LF);

    precise double z2 = z * z;
    precise double term = z;
    precise double sumValue = z;

    for (int k = 3; k <= 61; k += 2) {
        term = term * z2;
        sumValue = sumValue + term / double(k);
    }

    precise double result =
        2.0LF * sumValue + double(exponent) * LN2;

    return result;
}

double exp64(double x) {
    if (x < -745.0LF)
        return 0.0LF;

    int exponent = int(floor(x / LN2 + 0.5LF));

    precise double r =
        x - double(exponent) * LN2;

    precise double term = 1.0LF;
    precise double sumValue = 1.0LF;

    for (int k = 1; k <= 24; ++k) {
        term = term * r / double(k);
        sumValue = sumValue + term;
    }

    return ldexp(sumValue, exponent);
}

double pow64(double x, double y) {
    if (x == 0.0LF)
        return y == 0.0LF ? 1.0LF : 0.0LF;

    return exp64(y * log64(x));
}



float powerSingle(float x, float y) {
    if (isnan(x))
        return x;

    if (isinf(x))
        return y > 0.0 ? x : 0.0;

    if (x == 0.0)
        return y == 0.0 ? 1.0 : 0.0;

    return float(pow64(double(x), double(y)));
}

float copySignSingle(float magnitude, float signValue) {
    uint bits = floatBitsToUint(magnitude);
    uint signBits = floatBitsToUint(signValue);

    return uintBitsToFloat(
        (bits & 0x7fffffffu) |
        (signBits & 0x80000000u)
    );
}

void main() {

    uint i =
        gl_GlobalInvocationID.x +
        gl_GlobalInvocationID.y *
        gl_NumWorkGroups.x *
        gl_WorkGroupSize.x;

    if (i >= pc.count)
        return;

    // Preserve CPU masking operation order.

    precise float selfTerm =
        pc.ks * powerSingle(
            abs(selfActivity[i]), pc.q
        );

    precise float neighborTerm =
        pc.kn * powerSingle(
            abs(neighborActivity[i]), pc.q
        );

    precise float mask = selfTerm + 0.0;
    mask = mask + neighborTerm;

    precise float difference =
        testBand[i] - referenceBand[i];

    precise float excitation = copySignSingle(
        powerSingle(abs(difference), float(pc.p)),
        difference
    );

    precise float neural;

    if (pc.residual != 0u) {

        double noise = baseNoise[0];

        if (isinf(noise)) {
            neural = uintBitsToFloat(0x7f800000u);
        } else {
            neural = float(
                pow64(noise, 2.0LF * pc.p)
            );
        }

    } else {

        precise float inverseSensitivity =
            1.0 / sensitivity[i];

        neural = powerSingle(
            inverseSensitivity,
            float(2.0LF * pc.p)
        );
    }

    precise float maskTerm = mask * mask;

    precise float denominatorInput =
        neural + maskTerm;

    precise float denominator =
        sqrt(denominatorInput);

    precise float result =
        excitation / denominator;

    // The CPU pooling stage consumes raw_difference,
    // not the final signed power returned by masked_difference().

    rawDifference[i] = result;
}