#version 450
// General elementwise Single projection, with 2D dispatch for full 4K planes.
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input { float data[]; } src;
layout(set=0,binding=1,std430) writeonly buffer Output { float data[]; } dst;
layout(push_constant) uniform Push { uint count; uint pixels; uint unused0; uint unused1; } pc;
void main(){
 uint i=gl_GlobalInvocationID.x+gl_NumWorkGroups.x*gl_WorkGroupSize.x*gl_GlobalInvocationID.y;
 if(i>=pc.count)return;
 uint channel=i/pc.pixels,pixel=i%pc.pixels,base=3*pc.pixels+3*channel;
 precise float first=src.data[pixel]*src.data[base];
 precise float second=fma(src.data[pc.pixels+pixel],src.data[base+1],first);
 precise float value=fma(src.data[2*pc.pixels+pixel],src.data[base+2],second);
 if(pc.unused0==1)dst.data[i]=max(value,1e-6); // native color gamut floor
 else dst.data[i]=clamp(value,1e-8,1e10); // LMSR response floor/ceiling
}
