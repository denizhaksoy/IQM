#version 450
#extension GL_ARB_gpu_shader_fp64 : require
// Finite supported profile: log input floored to1e-6, exp log-domain[-32,32].
// Pinned source-order win-libm Single routines; official bit tests mandatory.
layout(local_size_x=64)in;
layout(set=0,binding=0,std430)readonly buffer Input{uint v[];}src;
layout(set=0,binding=1,std430)readonly buffer Unused{uint v[];}unusedBuffer;
layout(set=0,binding=2,std430)writeonly buffer Output{uint v[];}dst;
layout(set=0,binding=3,std430)buffer Status{uint v[];}status;
layout(push_constant)uniform P{uint count;uint mode;uint first;uint sampleStride;uint rowStride;uint a;uint b;uint c;}p;
double divRTE(double a,double b){precise double q=a/b;precise double r=fma(-q,b,a);return q+r/b;}
#extension GL_GOOGLE_include_directive : require
#include "local_adaptation_math.glsl"
void main(){uint i=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*64+gl_LocalInvocationID.x;if(i>=p.count)return;
 if(p.mode==0u){uint x=i%3840u,y=i/3840u;float v=uintBitsToFloat(src.v[p.first+x*p.sampleStride+y*p.rowStride]);dst.v[i]=floatBitsToUint(logNative(max(v,1e-6)));}
 else if(p.mode==1u){uint x=i/4320u,y=i%4320u;dst.v[i]=src.v[min(y,2159u)*3840u+min(x,3839u)];}
 else if(p.mode==2u){uint x=i%3840u,y=i/3840u;dst.v[i]=src.v[x*4320u+y];}
 else if(p.mode==3u){uint x=i%3840u,y=i/3840u;float f=uintBitsToFloat(src.v[i]);dst.v[p.first+x*p.sampleStride+y*p.rowStride]=abs(f)<=32.0?floatBitsToUint(expNative(f)):0x7fc00000u;}
}
