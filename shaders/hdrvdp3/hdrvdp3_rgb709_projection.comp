#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input { float data[]; } src;
layout(set=0,binding=1,std430) writeonly buffer Output { float data[]; } dst;
layout(push_constant) uniform Push { uint count; uint pixels; uint reserved0; uint reserved1; } pc;
// Three planar channels + column-major3x3 Float32 matrix. Raw then clamped planes.
void main(){
 uint i=gl_GlobalInvocationID.x;if(i>=pc.count)return;
 uint channel=i/pc.pixels,pixel=i%pc.pixels,base=3*pc.pixels;
 precise float first=src.data[pixel]*src.data[base+channel];
 precise float second=fma(src.data[pc.pixels+pixel],src.data[base+3+channel],first);
 precise float result=fma(src.data[2*pc.pixels+pixel],src.data[base+6+channel],second);
 dst.data[i]=result;dst.data[3*pc.pixels+i]=max(result,1e-6);
}
